# ===== Mailer configuration =====

EMAIL_SENDER=your.sender.email@gmail.com  # Address that will send the message.
EMAIL_RECEIVER=your.receiver.email@gmail.com # Address that will receive the message.
SMTP=smtp.gmail.com # Replace with your email provider smtp
PASSWORD=your-email-password  # Please create an App password or something to avoid using your real email password


# ===== PostgreSQL configuration =====

AUTOMATIC_DB_SETUP=0 # 1 for automatic PostgreSQL setup, 0 to disable automatic setup.
POSTGRES_PORT=5432
POSTGRES_ADMIN_USER=admin # Not needed if you create your own PosgreSQL setup
POSTGRES_ADMIN_PASSWORD=your-admin-password # Not needed if you create your own PostgreSQL setup
POSTGRES_PIPELINE_USER=pipeline
POSTGRES_PIPELINE_PASSWORD=your-postgres-password
POSTGRES_DB=db
POSTGRES_DATA_DIR=/path/to/where/you/want/to/store/postgres/data # Not needed if you create your own PostgreSQL setup
